# mock = built-in simulated agent (default)
# live = call the published Agentplace agent
AGENT_MODE=mock

# Required only when AGENT_MODE=live. This is the POST /api/send-message URL,
# not the agent page URL. The adapter derives the /ws session URL from it.
AGENT_BOOKING_URL=

# Optional bearer token for the published endpoint
AGENT_API_KEY=